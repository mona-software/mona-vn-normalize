diff --git a/tests/test_currency.py b/tests/test_currency.py
new file mode 100644
index 0000000000000000000000000000000000000000..fea564f0354639ee130ec6246dd553a830b66cc3
--- /dev/null
+++ b/tests/test_currency.py
@@ -0,0 +1,16 @@
+import pytest
+
+from mona_vn_normalize import read_currency
+
+
+@pytest.mark.parametrize(("value", "expected"), [
+    ("500k", "năm trăm nghìn đồng"),
+    ("2tr", "hai triệu đồng"),
+    ("1,5 triệu", "một triệu năm trăm nghìn đồng"),
